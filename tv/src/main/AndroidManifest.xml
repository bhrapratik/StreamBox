<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- TV has no touchscreen: without this, Play hides your app on TV -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!-- Declares this is a TV app -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <application
        android:name=".StreamBoxTvApp"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="StreamBox"
        android:theme="@style/Theme.StreamBox">
        <activity
            android:name=".TvMainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <!-- Shows the app on the TV home screen -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>